# ============================================
# AI-Powered Data Security & Compliance Agent
# ============================================
#
# SETUP (plug-and-play):
#   1. Copy this file to .env
#   2. Fill in the values below
#   3. az login
#   4. pip install -r requirements.txt
#   5. streamlit run app.py
#
# No extra wiring scripts. The app orchestrates the three prompt agents
# (Classification -> Risk Detection -> Compliance Advisor) itself.
#
# DO NOT commit real credentials to version control.
# ============================================

# ============================================
# REQUIRED: Microsoft Foundry project + agents
# ============================================

# Foundry project endpoint (new Foundry projects API).
# Get from: Microsoft Foundry portal > Your Project > Overview
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# Names of the three prompt agents (the new Foundry references agents by NAME,
# not by an asst_ ID). Get each from the Foundry portal > Agents > Setup panel.
AGENT_NAME=Data-Classification-Agent
RISK_AGENT_NAME=Risk-Detection-Agent
COMPLIANCE_AGENT_NAME=Compliance-Advisor-Agent

# ============================================
# REQUIRED: Azure Cosmos DB (scan history + alerts)
# ============================================
# Get from: Azure Portal > Cosmos DB account > Keys
COSMOS_ENDPOINT=
COSMOS_KEY=
DATABASE_NAME=SecurityAgentDB

# ============================================
# REQUIRED: Azure Storage Account (data assets)
# ============================================
# Get from: Azure Portal > Storage Account > Access Keys
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=

# ============================================
# REQUIRED: Azure Event Grid (critical alerts)
# ============================================
# Get from: Azure Portal > Event Grid Topic > Overview (Topic Endpoint)
EVENT_GRID_ENDPOINT=
# Get from: Azure Portal > Event Grid Topic > Access Keys
EVENT_GRID_KEY=
