# ============================================
# AI-Powered Data Security & Compliance Agent
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Rename this file to .env
# 2. Fill in your Azure credentials below
# 3. Run: az login
# 4. Run: python setup_a2a.py   (wires the A2A agent-to-agent hand-off)
# 5. Run: streamlit run app.py
#
# DO NOT commit real credentials to version control.
# ============================================

# ============================================
# REQUIRED: Microsoft Foundry project + agent
# ============================================

# Foundry project endpoint (new Foundry projects API)
# Get from: Microsoft Foundry portal > Your Project > Overview
# Format: https://<your-resource>.services.ai.azure.com/api/projects/proj-default
PROJECT_ENDPOINT=

# Name of the Data Classification prompt agent (the pipeline entry point).
# In the new Foundry, agents are referenced by NAME, not by an asst_ ID.
# Get from: Microsoft Foundry portal > Agents > your agent > Setup panel
AGENT_NAME=Data-Classification-Agent

# ============================================
# REQUIRED for A2A wiring (setup_a2a.py only)
# ============================================
# These identify your Foundry account/project so the script can enable
# incoming A2A and create the RemoteA2A connections. The app.py dashboard
# does NOT need these - only setup_a2a.py does.

SUBSCRIPTION_ID=
RESOURCE_GROUP=
FOUNDRY_ACCOUNT=
PROJECT_NAME=proj-default
MODEL_DEPLOYMENT_NAME=data-security-model

# Names of the two sub-agents that Classification delegates to via A2A.
RISK_AGENT_NAME=Risk-Detection-Agent
COMPLIANCE_AGENT_NAME=Compliance-Advisor-Agent

# ============================================
# REQUIRED: Azure Cosmos DB
# ============================================

# Get from: Azure Portal > Cosmos DB account > Keys
COSMOS_ENDPOINT=
COSMOS_KEY=
DATABASE_NAME=SecurityAgentDB

# ============================================
# REQUIRED: Azure Storage Account
# ============================================

# Get from: Azure Portal > Storage Account > Access Keys
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=

# ============================================
# REQUIRED: Azure Event Grid
# ============================================

# Get from: Azure Portal > Event Grid Topic > Overview (Topic Endpoint)
EVENT_GRID_ENDPOINT=

# Get from: Azure Portal > Event Grid Topic > Access Keys
EVENT_GRID_KEY=
